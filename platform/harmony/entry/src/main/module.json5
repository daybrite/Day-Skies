{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "Day on HarmonyOS ArkUI (native Rust cdylib)",
    "mainElement": "EntryAbility",
    // "default" is the OpenHarmony device type the Oniro emulator reports ("phone" is a HarmonyOS-only
    // syscap set, absent from the public OpenHarmony SDK's device-define).
    "deviceTypes": ["default", "tablet"],
    "deliveryWithInstall": true,
    // INTERNET for the live Open-Meteo fetch; `day build` appends [permissions] entries from
    // Day.toml between the day:permissions markers.
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      // day:permissions-begin — generated by `day build` from [permissions] in Day.toml.
      { "name": "ohos.permission.APPROXIMATELY_LOCATION", "reason": "$string:day_perm_reason_location_when_in_use", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.LOCATION", "reason": "$string:day_perm_reason_location_when_in_use", "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      // day:permissions-end
    ],
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Both abilities and both pages ($profile:main_pages) are the framework's: `day build`
    // stages them into ets/day/ from the day-arkui crate (docs/harmonyos.md), so the paths
    // below are fixed and never edited per app.
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/day/EntryAbility.ets",
        "description": "The app's main window",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      },
      {
        // Secondary day windows (docs/windows.md): one multiton instance per open window.
        "name": "DayWindowAbility",
        "srcEntry": "./ets/day/DayWindowAbility.ets",
        "description": "Day secondary window",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "multiton",
        "exported": false
      }
    ]
  }
}
